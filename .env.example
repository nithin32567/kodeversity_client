# Environment Variables — Kodeversity Nexus Client

# Copy this file to .env and fill in your service URLs.
# Each variable points to one Express microservice.

# Auth Service (login, register, OTP, JWT refresh) — listens on /api/auth/*
VITE_AUTH_SERVICE_URL=http://localhost:4000

# Course Service (courses, lessons, modules)
VITE_COURSE_SERVICE_URL=http://localhost:4002

# User Service (profile, settings)
VITE_USER_SERVICE_URL=http://localhost:4003

# Progress Service (lesson completion, certificates)
VITE_PROGRESS_SERVICE_URL=http://localhost:4004

# Challenge Service (coding challenges, submissions)
VITE_CHALLENGE_SERVICE_URL=http://localhost:4005
